{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Studyus",
  "version": "0.1.0",
  "identifier": "com.studyus.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "cross-env STUDYUS_TAURI=1 vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Studyus",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "pdfium/pdfium.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

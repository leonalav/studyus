    ───────────────────────────────────────────────────────────── */
 
+/* ─────────────────────────────────────────────────────────────
+   PARALLEL PLAN + OVERVIEW (session-opening greeting)
+   ───────────────────────────────────────────────────────────── */
+
+/**
+ * The minimum shape the plan agent must return. The full TutorTurn is not
+ * needed because the greeting turn's `speech` is the plan agent's greeting
+ * (the overview agent has nothing to say); the merge handles board op
+ * composition.
+ */
+interface PlanOnlyTurn {
+  speech: string;
+  boardOps: BoardOp[];
+}
+
+/** Mirror of PlanOnlyTurn for the overview agent. */
+interface OverviewOnlyTurn {
+  speech: string;
+  boardOps: BoardOp[];
+}
+
+/**
+ * System fragment the plan agent receives on top of the shared system prompt.
+ * Phrased as a directive: "your only output is a plan widget" is exactly the
+ * constraint, and the structural reminders map 1:1 to the validator checks in
+ * `validatePlanOnlyPayload`.
+ */
+function buildPlanAgentSystemFragment(
+  effort: ExplicitEffort,
+  cfg: EffortConstraints
+): string {
+  return [
+    "You are the study route planner for this session's greeting turn.",
+    "Your ONLY output is a single plan widget — board_ops must contain exactly one place_widget with intent.kind = \"plan\".",
+    `EFFORT LEVEL: ${effort.toUpperCase()}.`,
+    `Plan: ${cfg.minSteps}–${cfg.maxSteps} phases (must be in this range).`,
+    cfg.includePrerequisites ? "Include prerequisite skill identification in plan details." : null,
+    cfg.includeTimeEstimates ? "First detail item in each step is a time estimate (\"~30 min\", \"~2 hours\")." : null,
+    cfg.includeSuccessCriteria ? "Last detail item in each step is a success criterion (\"can solve X unaided\")." : null,
+    cfg.includePitfalls ? "An intermediate detail item is a common pitfall." : null,
+    cfg.includeSubActivities ? "Each step has 2–4 sub-activities in details[]." : null,
+    "The plan is a contract — it is the route from where the learner SAID they are (per intake answers) to mastery.",
+    "Step labels name outcomes, not topics. Details are sub-activities and meta-notes.",
+    "Do NOT exceed the step range. Do NOT pad with extra phases to look thorough.",
+  ].filter(Boolean).join("\n");
+}
+
+/**
+ * System fragment for the overview agent. The overview's job is the SCOPE
+ * (the full concept laid out so the learner sees the territory); the depth
+ * level controls which sections must be populated.
+ */
+function buildOverviewAgentSystemFragment(
+  effort: ExplicitEffort,
+  cfg: EffortConstraints
+): string {
+  const depthDirectives: Record<CurriculumDepth, string> = {
+    surface: "Be concise: vocabulary + formulas + youWillBeAbleTo only.",
+    medium: "Be thorough: include vocabulary + formulas + at least one of {properties, pitfalls, patterns}.",
+    deep: "Be comprehensive: include at least vocab + formulas + pitfalls + youWillBeAbleTo.",
+    exhaustive: "Be EXHAUSTIVE: populate every section — vocabulary, formulas, properties, graphs, pitfalls, patterns, youWillBeAbleTo.",
+  };
+  return [
+    "You are the concept cartographer for this session's greeting turn.",
+    "Your ONLY output is a single overview widget — board_ops must contain exactly one place_widget with intent.kind = \"overview\".",
+    `EFFORT LEVEL: ${effort.toUpperCase()}. Curriculum depth: ${cfg.curriculumDepth}.`,
+    depthDirectives[cfg.curriculumDepth],
+    "The overview is the SCOPE — it is the full concept laid out so the learner sees the territory.",
+    "Your speech may be empty; the plan agent owns the greeting.",
+  ].join("\n");
+}
+
+/**
+ * Validate that the plan agent returned a TutorTurn-shaped object with exactly
+ * one place_widget of kind=plan and nothing else. The plan widget itself is
+ * validated against the effort constraints.
+ */
+function validatePlanOnlyPayload(payload: unknown, cfg: EffortConstraints): ValidationResult<PlanOnlyTurn> {
+  if (!payload || typeof payload !== "object") {
+    return invalid("Plan agent response was not an object");
+  }
+  const root = payload as Record<string, unknown>;
+  const speech = typeof root.speech === "string" ? root.speech.trim() : "";
+  const rawOps = Array.isArray(root.board_ops)
+    ? root.board_ops
+    : Array.isArray(root.boardOps)
+      ? root.boardOps
+      : [];
+  if (rawOps.length !== 1) {
+    return invalid(`Plan agent must emit exactly one board_op; got ${rawOps.length}`);
+  }
+  const op = rawOps[0] as Record<string, unknown>;
+  if (op.op !== "place_widget") {
+    return invalid(`Plan agent's single board_op must be a place_widget; got ${String(op.op)}`);
+  }
+  const intent = op.intent as Record<string, unknown> | undefined;
+  if (!intent || intent.kind !== "plan") {
+    return invalid("Plan agent's widget intent must be of kind=plan");
+  }
+  // Defer to the structural validatePlan so the effort constraints apply.
+  const planResult = validatePlanWidget(intent, cfg);
+  if (!planResult.valid) {
+    return invalid(planResult.reason);
+  }
+  const speechErr: string[] = [];
+  const speechOk = asNonEmptyString(speech, "speech", speechErr);
+  if (!speechOk) return invalid(speechErr[0] ?? "Plan agent speech must be a non-empty string");
+  return { ok: true, value: { speech: speechOk, boardOps: [{ op: "place_widget", intent: intent as unknown as WidgetIntent }] } };
+}
+
+/**
+ * Validate that the overview agent returned a TutorTurn-shaped object with
+ * exactly one place_widget of kind=overview and nothing else.
+ */
+function validateOverviewOnlyPayload(payload: unknown): ValidationResult<OverviewOnlyTurn> {
+  if (!payload || typeof payload !== "object") {
+    return invalid("Overview agent response was not an object");
+  }
+  const root = payload as Record<string, unknown>;
+  const speech = typeof root.speech === "string" ? root.speech.trim() : "";
+  const rawOps = Array.isArray(root.board_ops)
+    ? root.board_ops
+    : Array.isArray(root.boardOps)
+      ? root.boardOps
+      : [];
+  if (rawOps.length !== 1) {
+    return invalid(`Overview agent must emit exactly one board_op; got ${rawOps.length}`);
+  }
+  const op = rawOps[0] as Record<string, unknown>;
+  if (op.op !== "place_widget") {
+    return invalid(`Overview agent's single board_op must be a place_widget; got ${String(op.op)}`);
+  }
+  const intent = op.intent as Record<string, unknown> | undefined;
+  if (!intent || intent.kind !== "overview") {
+    return invalid("Overview agent's widget intent must be of kind=overview");
+  }
+  // Reuse the structural overview validator.
+  const overviewCheck = validateOverviewWidgetOnly(intent);
+  if (!overviewCheck.valid) {
+    return invalid(overviewCheck.reason);
+  }
+  return { ok: true, value: { speech, boardOps: [{ op: "place_widget", intent: intent as unknown as WidgetIntent }] } };
+}
+
+/**
+ * Light structural check on the overview widget intent. We do not import the
+ * private `validateOverview` from widgets/validate.ts because it lives behind
+ * a module boundary; the full schema check happens after merge in the
+ * post-validate pass via `validateTutorPayload`.
+ */
+function validateOverviewWidgetOnly(intent: Record<string, unknown>): { valid: true } | { valid: false; reason: string } {
+  const concept = intent.concept;
+  const summary = intent.summary;
+  if (typeof concept !== "string" || !concept.trim()) {
+    return { valid: false, reason: "Overview needs a concept name" };
+  }
+  if (typeof summary !== "string" || !summary.trim()) {
+    return { valid: false, reason: "Overview needs a plain-language summary" };
+  }
+  return { valid: true };
+}
+
+/**
+ * Merge a successful plan-agent and overview-agent run into a single
+ * StructuredCallResult<TutorTurn>. The plan agent owns the speech (it is the
+ * greeting); the board ops are concatenated in plan-then-overview order so
+ * the learner sees the agreement pair in reading order. Latency is the max
+ * of the two parallel calls; attempts is the sum so telemetry still reflects
+ * total model calls.
+ */
+function mergePlanOverviewResults(
+  planResult: StructuredCallResult<PlanOnlyTurn>,
+  overviewResult: StructuredCallResult<OverviewOnlyTurn>,
+  introConcept: string | undefined,
+  sessionTitle: string | undefined
+): StructuredCallResult<TutorTurn> {
+  const fallbackConcept = introConcept ?? sessionTitle ?? "the concept";
+  const planOps = planResult.value?.boardOps ?? [];
+  const overviewOps = overviewResult.value?.boardOps ?? [];
+  const planSpeech = planResult.value?.speech ?? "";
+  const overviewSpeech = overviewResult.value?.speech ?? "";
+
+  // Synthesize the missing widget when one of the agents failed mid-call. The
+  // synthesis mirrors the post-validate fallback below so a learner who only
+  // sees one widget never makes a decision without the other.
+  const synthesized: BoardOp[] = [];
+  const hasPlan = planOps.some((op) => op.op === "place_widget" && op.intent.kind === "plan");
+  const hasOverview = overviewOps.some((op) => op.op === "place_widget" && op.intent.kind === "overview");
+  if (!hasPlan) {
+    synthesized.push({
+      op: "place_widget",
+      intent: {
+        kind: "plan",
+        heading: fallbackConcept,
+        steps: [
+          { id: "step-1", label: "Meet the idea" },
+          { id: "step-2", label: "Defend a claim" },
+        ],
+      },
+    });
+  }
+  if (!hasOverview) {
+    synthesized.push({
+      op: "place_widget",
+      intent: {
+        kind: "overview",
+        concept: fallbackConcept,
+        summary: `The full concept map for ${fallbackConcept}: identities, properties, graphs, vocabulary, pitfalls, and patterns — populated by the tutor during teaching.`,
+      },
+    });
+  }
+
+  // Plan first, then overview, so the agreement pair lands in reading order.
+  const orderedOps: BoardOp[] = [
+    ...planOps,
+    ...overviewOps,
+    ...synthesized,
+  ];
+
+  return {
+    value: {
+      speech: planSpeech || overviewSpeech || "Here is the route and the full concept map. Take a look, and tell me when you're ready to start.",
+      boardOps: orderedOps,
+      evidenceRefs: [],
+    },
+    modelId: planResult.modelId ?? overviewResult.modelId ?? "fallback",
+    latencyMs: Math.max(planResult.latencyMs ?? 0, overviewResult.latencyMs ?? 0),
+    usage: {
+      ...(planResult.usage ?? {}),
+      ...(overviewResult.usage ?? {}),
+    },
+    attempts: (planResult.attempts ?? 0) + (overviewResult.attempts ?? 0),
+    repaired: planResult.repaired || overviewResult.repaired,
+  };
+}
